# Supabase Client Configuration
# Si estas variables están vacías, la aplicación funcionará automáticamente en MODO DEMOSTRACIÓN
# con almacenamiento local reactivo (localStorage) y datos de prueba completos.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GEMINI_API_KEY: Requerido para integraciones de IA en caso de habilitarse.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL donde está alojado este applet.
APP_URL="MY_APP_URL"
